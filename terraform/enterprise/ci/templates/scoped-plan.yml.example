name: Illustrative enterprise Terraform scoped plan
on:
  workflow_dispatch:
    inputs:
      source_sha: { description: "Reviewed commit on main", required: true, type: string }
      root: { description: "Approved Terraform root", required: true, type: choice, options: [organizations, networking-core] }
permissions: { contents: read }
jobs:
  plan:
    runs-on: [self-hosted, linux, enterprise-terraform]
    environment: enterprise-plan
    permissions: { contents: read, id-token: write }
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with: { ref: '${{ inputs.source_sha }}', fetch-depth: 0, persist-credentials: false }
      - name: Verify exact reviewed commit is reachable from main
        run: |
          test "$(git rev-parse HEAD)" = "${{ inputs.source_sha }}"
          git merge-base --is-ancestor "${{ inputs.source_sha }}" origin/main
      - uses: hashicorp/setup-terraform@dfe3c3f87815947d99a8997f908cb6525fc44e9e # v4
        with: { terraform_version: 1.14.6, terraform_wrapper: false }
      - name: Verify runner artifact tools
        run: command -v age && command -v jq && command -v sha256sum && command -v tar
      - name: Select approved root and backend key
        run: |
          case "${{ inputs.root }}" in
            organizations) root=terraform/enterprise/organizations ;;
            networking-core) root=terraform/enterprise/networking/core ;;
            *) exit 2 ;;
          esac
          echo "TF_ROOT=$root" >> "$GITHUB_ENV"
          echo "TF_STATE_KEY=enterprise/${{ inputs.root }}/terraform.tfstate" >> "$GITHUB_ENV"
      - name: Assume root-scoped read-only planning identity
        uses: aws-actions/configure-aws-credentials@4a1596c86fd706dc0521e32f0121ad1a6d1adb74 # v6
        with:
          role-to-assume: ${{ vars.ENTERPRISE_PLAN_ROLE_ARN }}
          aws-region: eu-central-1
          role-session-name: plan-${{ github.run_id }}
      - name: Initialize exact remote state and create plan
        run: |
          terraform -chdir="$TF_ROOT" init -input=false \
            -backend-config="bucket=${{ vars.ENTERPRISE_STATE_BUCKET }}" \
            -backend-config="key=$TF_STATE_KEY" \
            -backend-config="region=eu-central-1" \
            -backend-config="use_lockfile=true"
          terraform -chdir="$TF_ROOT" validate
          terraform -chdir="$TF_ROOT" plan -input=false -out="$RUNNER_TEMP/review.tfplan"
      - name: Build commit and state-bound artifact manifest
        run: |
          jq -n --arg source_sha "${{ inputs.source_sha }}" --arg root "${{ inputs.root }}" \
            --arg run_id "${{ github.run_id }}" \
            --arg plan_sha256 "$(sha256sum "$RUNNER_TEMP/review.tfplan" | cut -d' ' -f1)" \
            --arg lock_sha256 "$(sha256sum "$TF_ROOT/.terraform.lock.hcl" | cut -d' ' -f1)" \
            '{source_sha:$source_sha,root:$root,run_id:$run_id,plan_sha256:$plan_sha256,lock_sha256:$lock_sha256}' \
            > "$RUNNER_TEMP/manifest.json"
          tar -C "$RUNNER_TEMP" -cf "$RUNNER_TEMP/review.tar" review.tfplan manifest.json
          age -r "${{ vars.PLAN_ARTIFACT_RECIPIENT }}" -o "$RUNNER_TEMP/review.tar.age" "$RUNNER_TEMP/review.tar"
          sha256sum "$RUNNER_TEMP/review.tar.age" | tee "$RUNNER_TEMP/artifact.sha256"
          cat "$RUNNER_TEMP/artifact.sha256" >> "$GITHUB_STEP_SUMMARY"
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7
        with:
          name: enterprise-plan-${{ github.run_id }}
          path: |
            ${{ runner.temp }}/review.tar.age
            ${{ runner.temp }}/artifact.sha256
          retention-days: 2
