name: Illustrative enterprise Terraform pull-request validation
on: { pull_request: {} }
permissions: { contents: read }
jobs:
  validate:
    runs-on: [self-hosted, linux, enterprise-terraform]
    permissions: { contents: read }
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with: { persist-credentials: false }
      - uses: hashicorp/setup-terraform@dfe3c3f87815947d99a8997f908cb6525fc44e9e # v4
        with: { terraform_version: 1.14.6, terraform_wrapper: false }
      - name: Verify runner security tools
        run: command -v trivy && trivy --version && command -v python3
      - run: terraform fmt -check -recursive terraform/enterprise
      - run: python3 terraform/enterprise/tests/test_enterprise.py
      - name: Static security analysis
        run: trivy config --exit-code 1 terraform/enterprise
